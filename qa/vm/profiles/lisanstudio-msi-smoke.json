{
    "schemaVersion": 1,
    "class": "vm-gui",
    "vmName": "LisanStudio-QA",
    "approvalRequired": true,
    "purpose": "Project-owned profile for Lisan Studio MSI, GUI, Arabic, and RTL validation in the isolated LisanStudio-QA runner.",
    "phases": [
        "confirm approval packet",
        "run tooling-first guest provisioning for LisanStudio-QA only",
        "copy the active repo workspace and apython payload into C:\\CodexRunner\\work",
        "require a logged-on LISAN-QA\\codexqa desktop session",
        "run validate plus release-evidence through a one-shot interactive scheduled task in the isolated lane",
        "collect logs, screenshots, checksums, and summary evidence",
        "review cleanup or rollback expectations"
    ],
    "projectScripts": {
        "build": "scripts\\build.ps1",
        "package": "scripts\\package.ps1",
        "installedSmoke": "scripts\\installed-smoke.ps1",
        "msiSmoke": "scripts\\msi-smoke.ps1",
        "releaseEvidence": "scripts\\release-evidence.ps1"
    },
    "artifacts": {
        "hostLogs": [
            "validate.stdout.log",
            "validate.stderr.log",
            "validate.log",
            "release-evidence.stdout.log",
            "release-evidence.stderr.log",
            "release-evidence.log",
            "artifacts\\msi-smoke\\install.log",
            "artifacts\\msi-smoke\\uninstall.log",
            "artifacts\\msi-smoke\\preclean-uninstall.log",
            "artifacts\\release\\0.1.0-beta\\logs\\package.log",
            "artifacts\\release\\0.1.0-beta\\logs\\msi-smoke-keep-installed.log"
        ],
        "screenshots": [
            "artifacts\\release\\0.1.0-beta\\screenshots\\main-window.png"
        ],
        "summaries": [
            "artifacts\\release\\0.1.0-beta\\VALIDATION_LOG.md",
            "artifacts\\release\\0.1.0-beta\\CHECKSUMS-SHA256.txt",
            "artifacts\\release\\0.1.0-beta\\KNOWN_ISSUES.md"
        ],
        "guestReports": [
            "guest-provisioning-readiness.json",
            "smoke-summary.json",
            "smoke-summary.md"
        ]
    },
    "commands": [],
    "activeWhitedragonAllowed": false,
    "guestProvisioning": {
        "scriptPath": "qa\\vm\\Install-LisanStudioQaGuest.ps1",
        "approvalRequired": true,
        "dryRunOnly": false,
        "mutationImplementationEnabled": true,
        "purpose": "Project-owned tooling-first LisanStudio-QA provisioning. Confirms the Homelab approval packet, refuses active WHITEDRAGON, installs or validates the exact repo prerequisites, and writes readiness plus tooling JSON reports."
    },
    "msiGuiSmoke": {
        "scriptPath": "qa\\vm\\Invoke-LisanStudioVmSmoke.ps1",
        "approvalRequired": true,
        "dryRunOnly": false,
        "mutationImplementationEnabled": true,
        "purpose": "Project-owned real isolated execution for Lisan Studio MSI, GUI, Arabic, and RTL smoke validation through the LisanStudio-QA project-vm lane.",
        "artifactPlan": [
            "validate.stdout.log",
            "validate.stderr.log",
            "validate.result.json",
            "validate.log",
            "release-evidence.stdout.log",
            "release-evidence.stderr.log",
            "release-evidence.result.json",
            "release-evidence.log",
            "VALIDATION_LOG.md",
            "CHECKSUMS-SHA256.txt",
            "KNOWN_ISSUES.md",
            "main-window.png",
            "smoke-summary.json",
            "smoke-summary.md"
        ]
    },
    "notes": "No secrets, credentials, or arbitrary shell command arrays are stored in this profile. Project-specific flow stays in this repo; Homelab core remains generic."
}
